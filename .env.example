# ─────────────────────────────────────────────
# Cyrus AI – environment variable template
# Copy to .env and fill in your real values.
# ─────────────────────────────────────────────

# ── Provider ──────────────────────────────────
# Which LLM provider to use (openai | grok | deepseek)
CYRUS_PROVIDER=openai

# ── OpenAI ────────────────────────────────────
OPENAI_API_KEY=sk-...

# Model names (change to gpt-4o, gpt-4-turbo, etc.)
CYRUS_CHAT_MODEL=gpt-4o-mini
CYRUS_EMBED_MODEL=text-embedding-3-small

# ── Qdrant ────────────────────────────────────
QDRANT_URL=http://qdrant:6333
CYRUS_COLLECTION=cyrus_messages

# ── App env ───────────────────────────────────
CYRUS_ENV=local

# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
